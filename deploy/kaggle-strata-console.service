[Unit]
Description=Kaggle Strata private console
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/kaggle-strata-console
EnvironmentFile=/home/ubuntu/kaggle-strata-console/.env
ExecStart=/home/ubuntu/kaggle-strata-console/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 18786 --no-access-log --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/kaggle-strata-console/data
UMask=0077

[Install]
WantedBy=multi-user.target
